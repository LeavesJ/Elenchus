# Local notes and documents (root-level markdown and PDFs are never tracked)
/*.md
*.pdf

# Internal process docs and tooling config — never tracked
/docs/
.claude/
.superpowers/
.claude-flow/
.worktrees/

# Runtime state
/data/
*.db
*.sqlite
*.sqlite3

# Real content banks stay local; the tracked *.example.yaml stubs are the public shape
/content/lift/scenarios.yaml
/content/lift/candidates.yaml
# Real injection payloads are a live exploit against our own grader; only the shape is public
/data/injection_payloads.yaml

# Secrets
.env
.env.*
!.env.example
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# OS
.DS_Store
